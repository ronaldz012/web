---
import type { SiteSettings } from "../lib/sanity";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const label = settings.labels?.process ?? "Cómo trabajamos";
const steps = settings.process ?? [];
---

{
  steps.length > 0 && (
    <section id="proceso" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
        <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">{label}</h2>
        <ol class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((step, i) => (
            <li class="border-t border-line pt-5">
              <span class="font-display text-3xl font-medium text-accent">{i + 1}</span>
              <h3 class="mt-3 font-display text-lg font-medium text-ink">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-body">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
