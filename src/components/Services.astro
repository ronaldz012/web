---
import type { SiteSettings, SiteData } from "../lib/sanity";

interface Props {
  settings: SiteSettings;
  services: SiteData["services"];
}

const { settings, services } = Astro.props;
const label = settings.labels?.services ?? "Servicios";
---

{
  services.length > 0 && (
    <section id="servicios" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
        <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">{label}</h2>
        <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service, i) => (
            <li class="border border-line bg-card p-6">
              <p class="font-display text-sm font-medium text-accent">
                {(i + 1).toString().padStart(2, "0")}
              </p>
              <h3 class="mt-2 font-display text-lg font-medium text-ink">{service.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-body">{service.problem}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
