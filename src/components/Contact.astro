---
import { waLink, type SiteSettings } from "../lib/sanity";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const label = settings.labels?.contact ?? "Contacto";
const c = settings.contact ?? {};

const wa = c.whatsapp ? waLink(c.whatsapp, "Hola, quiero consultar por sus servicios.") : null;
const digits = (c.whatsapp ?? "").replace(/\D/g, "");

// WhatsApp en formato legible: 59170000000 → +591 70000000
const waPretty = digits.length > 3
  ? `+${digits.slice(0, digits.length - 8)} ${digits.slice(-8)}`
  : digits;
---

<section id="contacto" class="border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">{label}</h2>

    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div class="space-y-6 text-sm leading-relaxed">
        {
          c.address && (
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-body/60">Dirección</p>
              <p class="mt-1 text-ink">{c.address}</p>
            </div>
          )
        }
        {
          c.hours && c.hours.length > 0 && (
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-body/60">Horarios</p>
              <ul class="mt-1">
                {c.hours.map((h) => (
                  <li class="text-ink">
                    {h.days} · <span class="text-body">{h.time}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-body/60">Contacto directo</p>
          <ul class="mt-1 space-y-1">
            {waPretty && (
              <li>
                <a href={wa} target="_blank" rel="noopener noreferrer" class="text-ink underline-offset-4 hover:text-accent hover:underline">
                  WhatsApp {waPretty}
                </a>
              </li>
            )}
            {c.phone && <li class="text-ink">{c.phone}</li>}
            {c.email && (
              <li>
                <a href={`mailto:${c.email}`} class="text-ink underline-offset-4 hover:text-accent hover:underline">
                  {c.email}
                </a>
              </li>
            )}
          </ul>
        </div>
        {
          c.social && c.social.length > 0 && (
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-body/60">Redes</p>
              <ul class="mt-1 flex gap-4">
                {c.social.map((s) => (
                  <li>
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-ink underline-offset-4 hover:text-accent hover:underline"
                    >
                      {s.platform}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <form id="contact-form" data-wa={digits} class="space-y-4">
        <div>
          <label for="f-name" class="text-xs font-medium uppercase tracking-[0.14em] text-body/60">
            Nombre
          </label>
          <input
            id="f-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-1 w-full border border-line bg-card px-4 py-3 text-sm text-ink focus:border-accent focus:outline-none"
          />
        </div>
        <div>
          <label for="f-msg" class="text-xs font-medium uppercase tracking-[0.14em] text-body/60">
            Tu consulta
          </label>
          <textarea
            id="f-msg"
            name="message"
            rows="4"
            required
            class="mt-1 w-full border border-line bg-card px-4 py-3 text-sm text-ink focus:border-accent focus:outline-none"
          />
        </div>
        <button
          type="submit"
          class="w-full bg-accent px-6 py-3 text-sm font-semibold text-onaccent transition-opacity hover:opacity-90"
        >
          Enviar por WhatsApp
        </button>
        <p class="text-xs text-body/60">Al enviar se abre WhatsApp con tu mensaje listo.</p>
      </form>
    </div>

    {
      c.mapEmbedUrl && (
        <iframe
          src={c.mapEmbedUrl}
          title="Mapa de ubicación"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="mt-10 h-72 w-full border border-line"
        />
      )
    }
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = document.getElementById("f-name").value.trim();
      const message = document.getElementById("f-msg").value.trim();
      const digits = form.getAttribute("data-wa") || "";
      const text = "Hola, soy " + name + ". " + message;
      window.open(
        "https://wa.me/" + digits + "?text=" + encodeURIComponent(text),
        "_blank",
        "noopener"
      );
    });
  }
</script>
