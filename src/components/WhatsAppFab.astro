---
import { waLink } from "../lib/sanity";

interface Props {
  whatsapp?: string;
}

const { whatsapp } = Astro.props;
if (!whatsapp) return;
const href = waLink(whatsapp, "Hola, quiero consultar por sus servicios.");
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="whatsapp-fab fixed right-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/20 transition-transform duration-200 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:hover:scale-100"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    class="h-7 w-7"
  >
    <path
      d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2Zm0 18.02c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.13 8.13 0 0 1-1.25-4.33c0-4.5 3.66-8.16 8.16-8.16s8.15 3.66 8.15 8.16-3.66 8.19-8.07 8.19Zm4.47-6.1c-.24-.12-1.45-.71-1.67-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.75-1.81-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.45-.59 1.65-1.17.2-.58.2-1.07.14-1.17-.06-.1-.22-.16-.46-.28Z"
    />
  </svg>
</a>

<style>
  .whatsapp-fab {
    bottom: max(1rem, env(safe-area-inset-bottom));
  }
  /* En desktop sube a media altura del borde derecho: integrado al contenido,
     no pegado a la esquina. */
  @media (min-width: 1024px) {
    .whatsapp-fab {
      bottom: 30vh;
    }
  }
</style>
