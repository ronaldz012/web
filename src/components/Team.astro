---
import { urlFor, type SiteSettings, type SiteData } from "../lib/sanity";

interface Props {
  settings: SiteSettings;
  team: SiteData["team"];
}

const { settings, team } = Astro.props;
const label = settings.labels?.team ?? "El estudio";
const title = settings.aboutTitle ?? label;

// Monograma: iniciales del nombre (sin títulos como "Lic."). Solo si no hay foto.
function initials(name?: string) {
  if (!name) return "·";
  const words = name
    .split(" ")
    .filter((w) => !/^(lic\.?|dr\.?|cp\.?|cpa)$/i.test(w.trim()))
    .filter(Boolean);
  return words
    .slice(0, 2)
    .map((w) => w[0]!.toUpperCase())
    .join("");
}

const paragraphs = (settings.about ?? "").split(/\n\s*\n/).filter(Boolean);
---

<section id="estudio" class="border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">{title}</h2>
    <div class="mt-6 max-w-2xl space-y-4 text-sm leading-relaxed text-body sm:text-base">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((member) => (
          <li class="border border-line bg-card p-6">
            {member.photo ? (
              <img
                src={urlFor(member.photo).width(160).height(160).url()}
                alt={member.photo.alt ?? member.name ?? ""}
                width="160"
                height="160"
                class="h-20 w-20 rounded-full object-cover"
              />
            ) : (
              <div class="flex h-20 w-20 items-center justify-center rounded-full border border-line bg-sage">
                <span class="font-display text-xl font-medium text-ink">{initials(member.name)}</span>
              </div>
            )}
            <h3 class="mt-4 font-display text-lg font-medium text-ink">{member.name}</h3>
            <p class="mt-1 text-sm text-body/80">{member.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
