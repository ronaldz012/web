---
import { urlFor, waLink, type SiteSettings } from "../lib/sanity";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;

// Defaults en código: el Studio los pre-carga, pero si falta alguno la
// landing no se rompe.
const labels = {
  services: settings.labels?.services ?? "Servicios",
  process: settings.labels?.process ?? "Cómo trabajamos",
  team: settings.labels?.team ?? "El estudio",
  results: settings.labels?.results ?? "Resultados",
  faq: settings.labels?.faq ?? "Preguntas frecuentes",
  contact: settings.labels?.contact ?? "Contacto",
};

const links = [
  ["#servicios", labels.services],
  ["#proceso", labels.process],
  ["#estudio", labels.team],
  ["#resultados", labels.results],
  ["#faq", labels.faq],
  ["#contacto", labels.contact],
];

const wa = settings.contact?.whatsapp
  ? waLink(settings.contact.whatsapp, "Hola, quiero consultar por sus servicios.")
  : null;
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="#inicio" class="flex items-center gap-3" aria-label={settings.name}>
      {
        settings.logo ? (
          <img
            src={urlFor(settings.logo).width(200).url()}
            alt={settings.logo.alt ?? settings.name ?? ""}
            class="h-8 w-auto"
          />
        ) : (
          <span class="font-display text-xl font-semibold text-ink">{settings.name}</span>
        )
      }
      {
        settings.sectorTitle && (
          <span class="hidden text-xs font-medium uppercase tracking-[0.14em] text-body/60 lg:inline">
            {settings.sectorTitle}
          </span>
        )
      }
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Secciones">
      {
        links.map(([href, text]) => (
          <a href={href} class="text-sm text-body transition-colors hover:text-ink">
            {text}
          </a>
        ))
      }
    </nav>

    {
      wa && (
        <a
          href={wa}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden border border-line px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent sm:inline-block"
        >
          WhatsApp
        </a>
      )
    }
  </div>
</header>
